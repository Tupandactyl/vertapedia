 "sections": [
  {
   "h": null,
   "en": null,
   "level": 1,
   "paras": [
    {
     "ref": "0.0",
     "text": "*Agama boueti*(Mali agama)는 아가마과(Agamidae)에 속하는 도마뱀의 한 종이다. 서아프리카 원산이다."
    }
   ]
  },
  {
   "h": "어원",
   "en": "Etymology",
   "level": 2,
   "paras": [
    {
     "ref": "1.0",
     "text": "종소명 boueti는 프랑스의 조류학자이자 의사였던 조르주 부에(Georges Bouet, 1869~1957)를 기리는 것이다."
    }
   ]
  },
  {
   "h": "분포 범위",
   "en": "Geographic range",
   "level": 2,
   "paras": [
    {
     "ref": "2.0",
     "text": "*A. boueti*는 부르키나파소, 말리, 모리타니, 모로코, 니제르, 세네갈에 분포한다."
    }
   ]
  },
  {
   "h": "서식지",
   "en": "Habitat",
   "level": 2,
   "paras": [
    {
     "ref": "3.0",
     "text": "*A. boueti*가 선호하는 자연 서식지는 사바나, 관목지, 바위 지대이다."
    }
   ]
  },
  {
   "h": "형태",
   "en": "Description",
   "level": 2,
   "paras": [
    {
     "ref": "4.0",
     "text": "작은 도마뱀인 *A. boueti*는 주둥이-항문 길이(SVL)가 7.7 cm, 긴 꼬리를 포함한 전체 길이가 22.2 cm에 이를 수 있다."
    }
   ]
  },
  {
   "h": "먹이",
   "en": "Diet",
   "level": 2,
   "paras": [
    {
     "ref": "5.0",
     "text": "*A. boueti*는 메뚜기, 개미, 딱정벌레와 다른 작은 절지동물을 잡아먹는다. 다육식물도 먹는다."
    }
   ]
  },
  {
   "h": "번식",
   "en": "Reproduction",
   "level": 2,
   "paras": [
    {
     "ref": "6.0",
     "text": "*A. boueti*는 난생이다."
    }
   ]
  }
 ],

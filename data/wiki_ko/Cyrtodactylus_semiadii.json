  {
   "h": "분포 범위",
   "en": "Geographic range",
   "level": 2,
   "paras": [
    {
     "ref": "2.0",
     "text": "*C. semiadii*는 자바섬 동부 동자바주에서 발견된다."
    }
   ]
  },
  {

 "sections": [
  {
   "h": null,
   "en": null,
   "level": 1,
   "paras": [
    {
     "ref": "0.0",
     "text": "*Hemidactylus granti*(Grant's leaf-toed gecko)는 도마뱀부치과(Gekkonidae)의 도마뱀 한 종이다. 소코트라섬 고유종이다. 보통 절벽이나 산꼭대기 같은 바위 지대에서 몸을 숨기고 있는 모습이 발견된다."
    }
   ]
  },
  {
   "h": "어원",
   "en": "Etymology",
   "level": 2,
   "paras": [
    {
     "ref": "1.0",
     "text": "종소명 *granti*는 스코틀랜드 조류학자 윌리엄 로버트 오길비그랜트(William Robert Ogilvie-Grant)를 기려 붙였다."
    }
   ]
  },
  {
   "h": "분포",
   "en": "Geographic range",
   "level": 2,
   "paras": [
    {
     "ref": "2.0",
     "text": "*H. granti*는 예멘 소코트라섬의 하지히르산맥(Hajhir Mountains)에서 발견된다."
    }
   ]
  },
  {
   "h": "서식지",
   "en": "Habitat",
   "level": 2,
   "paras": [
    {
     "ref": "3.0",
     "text": "*H. granti*가 선호하는 자연 서식지는 석회암이 아닌 바위 지대이며 해발 970~1,463m이다."
    }
   ]
  },
  {
   "h": "번식",
   "en": "Reproduction",
   "level": 2,
   "paras": [
    {
     "ref": "4.0",
     "text": "*H. granti*는 난생이다. 알은 바위 틈과 돌 밑에 최대 80개까지 공동으로 낳는다."
    }
   ]
  }
 ],

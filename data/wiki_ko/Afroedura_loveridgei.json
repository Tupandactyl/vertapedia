   "en": "Diet",
   "level": 2,
   "paras": [
    {
     "ref": "5.0",
     "text": "*Afroedura loveridgei*의 먹이는 딱정벌레, 메뚜기와 그 밖의 곤충이다."
    }
   ]
  },
  {

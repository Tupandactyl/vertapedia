 "sections": [
  {
   "h": null,
   "en": null,
   "level": 1,
   "paras": [
    {
     "ref": "0.0",
     "text": "*Agama doriae*(Benoue agama, Doria's agama, Nigeria agama)는 아가마과(Agamidae)에 속하는 도마뱀의 한 종이다. 아프리카 고유종이다. 인정되는 아종은 둘이다."
    }
   ]
  },
  {
   "h": "어원",
   "en": "Etymology",
   "level": 2,
   "paras": [
    {
     "ref": "1.0",
     "text": "종소명 doriae는 이탈리아의 박물학자 자코모 도리아(Giacomo Doria)를 기리는 것이다."
    }
   ]
  },
  {
   "h": "분포 범위",
   "en": "Geographic range",
   "level": 2,
   "paras": [
    {
     "ref": "2.0",
     "text": "*A. doriae*는 카메룬, 중앙아프리카공화국, 에리트레아, 에티오피아, 가나, 나이지리아, 수단, 토고에 분포한다."
    }
   ]
  },
  {
   "h": "서식지",
   "en": "Habitat",
   "level": 2,
   "paras": [
    {
     "ref": "3.0",
     "text": "*A. doriae*가 선호하는 자연 서식지는 숲, 사바나, 관목지의 바위 지대로 해발 700~2,300 m이지만 농경지에서도 발견된다."
    }
   ]
  },
  {
   "h": "형태",
   "en": "Description",
   "level": 2,
   "paras": [
    {
     "ref": "4.0",
     "text": "*A. doriae* 성체의 주둥이-항문 길이(SVL)는 약 10.5 cm이다."
    }
   ]
  },
  {
   "h": "번식",
   "en": "Reproduction",
   "level": 2,
   "paras": [
    {
     "ref": "5.0",
     "text": "*A. doriae*는 난생이다."
    }
   ]
  },
  {
   "h": "아종",
   "en": "Subspecies",
   "level": 2,
   "paras": [
    {
     "ref": "6.0",
     "text": "기준 아종을 포함해 두 아종이 유효한 것으로 인정된다."
    },
    {
     "ref": "6.1",
     "text": "*Agama doriae benueensis* Monard, 1951"
    },
    {
     "ref": "6.2",
     "text": "*Agama doriae doriae* Boulenger, 1885"
    }
   ]
  }
 ],

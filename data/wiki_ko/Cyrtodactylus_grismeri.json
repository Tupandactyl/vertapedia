   "en": "Habitat",
   "level": 2,
   "paras": [
    {
     "ref": "2.0",
     "text": "*C. grismeri*가 선호하는 자연 서식지는 해발 100m 안팎 숲의 동굴이다."
    }
   ]
  },
  {

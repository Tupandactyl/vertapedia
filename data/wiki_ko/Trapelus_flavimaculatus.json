 "sections": [
  {
   "h": null,
   "en": null,
   "level": 1,
   "paras": [
    {
     "ref": "0.0",
     "text": "*Trapelus flavimaculatus*(yellow-spotted agama)는 아가마과(Agamidae)에 속하는 흔한 도마뱀의 한 종이다. 중동 고유종이다."
    }
   ]
  },
  {
   "h": "분포",
   "en": "Geographic range",
   "level": 2,
   "paras": [
    {
     "ref": "1.0",
     "text": "*T. flavimaculatus*는 아라비아반도의 건조 지역인 오만, 카타르, 사우디아라비아, 아랍에미리트, 예멘에서 발견된다."
    }
   ]
  },
  {
   "h": "서식지",
   "en": "Habitat",
   "level": 2,
   "paras": [
    {
     "ref": "2.0",
     "text": "사막과 관목지의 모래땅이나 자갈땅에 살며 해발 0~1,200 m에서 발견된다."
    }
   ]
  },
  {
   "h": "먹이",
   "en": "Diet",
   "level": 2,
   "paras": [
    {
     "ref": "3.0",
     "text": "*T. flavimaculatus*는 주로 곤충을 먹는다."
    }
   ]
  },
  {
   "h": "행동",
   "en": "Behaviour",
   "level": 2,
   "paras": [
    {
     "ref": "4.0",
     "text": "낮에 활동하며 햇볕을 쬐려고 덤불에 오른다."
    }
   ]
  },
  {
   "h": "번식",
   "en": "Reproduction",
   "level": 2,
   "paras": [
    {
     "ref": "5.0",
     "text": "*T. flavimaculatus*는 난생이다. 한배 알 수는 4~6개이다."
    }
   ]
  },
  {
   "h": "형태",
   "en": "Description",
   "level": 2,
   "paras": [
    {
     "ref": "6.0",
     "text": "*T. flavimaculatus* 수컷은 목 아랫면의 눈에 띄는 파란색으로 흔히 알려져 있다."
    }
   ]
  }
 ],
 "skipped": [],
 "notes": [
  {
   "ref": "0.0",
   "type": "번역 메모",
   "text": "이 종은 사이트에 국명이 없어 학명으로 적고 영어 이름 yellow-spotted agama는 괄호에 두었다."
  },
  {
   "ref": "2.0",
   "type": "번역 메모",
   "text": "피트 병기를 뺐다."
  }
 ]

 "sections": [
  {
   "h": null,
   "en": null,
   "level": 1,
   "paras": [
    {
     "ref": "0.0",
     "text": "*Agama finchi*(Finch's agama)는 아가마과(Agamidae)에 속하는 작은 도마뱀의 한 종이다. 중앙아프리카와 동아프리카 원산이다. 인정되는 아종은 둘이다."
    }
   ]
  },
  {
   "h": "어원",
   "en": "Etymology",
   "level": 2,
   "paras": [
    {
     "ref": "1.0",
     "text": "종소명 finchi는 이 종을 발견한 동물학자 브라이언 W. 핀치(Brian W. Finch)를 기리는 것이다."
    }
   ]
  },
  {
   "h": "분포 범위",
   "en": "Geographic range",
   "level": 2,
   "paras": [
    {
     "ref": "2.0",
     "text": "*A. finchi*는 중앙아프리카공화국, 차드, 콩고민주공화국, 에티오피아, 케냐, 우간다에 분포한다."
    }
   ]
  },
  {
   "h": "서식지",
   "en": "Habitat",
   "level": 2,
   "paras": [
    {
     "ref": "3.0",
     "text": "*A. finchi*가 선호하는 자연 서식지는 초원이다."
    }
   ]
  },
  {
   "h": "형태",
   "en": "Description",
   "level": 2,
   "paras": [
    {
     "ref": "4.0",
     "text": "*A. finchi*는 속 중에서 작은 편으로 꼬리를 포함한 전체 길이가 25 cm를 넘지 않는다."
    }
   ]
  },
  {
   "h": "번식",
   "en": "Reproduction",
   "level": 2,
   "paras": [
    {
     "ref": "5.0",
     "text": "*A. finchi*는 난생이다."
    }
   ]
  },
  {
   "h": "아종",
   "en": "Subspecies",
   "level": 2,
   "paras": [
    {
     "ref": "6.0",
     "text": "기준 아종을 포함해 두 아종이 유효한 것으로 인정된다."
    },
    {
     "ref": "6.1",
     "text": "*Agama finchi finchi* Böhme et al., 2005"
    },
    {
     "ref": "6.2",
     "text": "*Agama finchi leucerythrolaema* Wagner et al., 2011"
    }
   ]
  }

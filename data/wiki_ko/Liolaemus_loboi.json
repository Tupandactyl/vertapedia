 "sections": [
  {
   "h": null,
   "en": null,
   "level": 1,
   "paras": [
    {
     "ref": "0.0",
     "text": "*Liolaemus loboi*는 고원도마뱀과의 도마뱀 종이다. 아르헨티나 고유종이다."
    }
   ]
  },
  {
   "h": "어원",
   "en": "Etymology",
   "level": 2,
   "paras": [
    {
     "ref": "1.0",
     "text": "종소명 *loboi*는 아르헨티나의 파충류학자 페르난도 호세 로보(Fernando José Lobo)를 기리는 것이다."
    }
   ]
  },
  {
   "h": "형태",
   "en": "Description",
   "level": 2,
   "paras": [
    {
     "ref": "2.0",
     "text": "*L. loboi*는 이 속에서 중간 크기이며, 주둥이-총배설강 길이(SVL)가 7.25 cm까지 자랄 수 있다."
    }
   ]
  },
  {
   "h": "분포",
   "en": "Geographic range",
   "level": 2,
   "paras": [
    {
     "ref": "3.0",
     "text": "*L. loboi*는 아르헨티나의 네우켄주와 리오네그로주에 분포한다."
    }
   ]
  },
  {
   "h": "서식지",
   "en": "Habitat",
   "level": 2,
   "paras": [
    {
     "ref": "4.0",
     "text": "*L. loboi*가 선호하는 자연 서식지는 모래 토양의 관목지이며, 해발 800–900 m에 산다."
    }
   ]
  },
  {
   "h": "행동과 생태",
   "en": "Behavior and ecology",
   "level": 2,
   "paras": [
    {
     "ref": "5.0",
     "text": "*L. loboi*는 지상성이다. 네네오(*Mulinum spinosum*) 가시덤불과 코이론(*Festuca gracillima*) 풀에 엄격하게 연관되어 산다."
    }
   ]
  },
  {
   "h": "먹이",
   "en": "Diet",
   "level": 2,
   "paras": [
    {
     "ref": "6.0",
     "text": "*L. loboi*는 주로 곤충을 잡아먹는다."
    }
   ]
  },
  {
   "h": "번식",
   "en": "Reproduction",
   "level": 2,
   "paras": [
    {
     "ref": "7.0",
     "text": "*L. loboi*는 난생이다."
    }
   ]
  },
  {
   "h": "분류",
   "en": "Taxonomy",
   "level": 2,
   "paras": [
    {
     "ref": "8.0",
     "text": "*L. loboi*는 *L. boulengeri* 종군에 속한다."
    }
   ]
  }
 ],

 "sections": [
  {
   "h": null,
   "en": null,
   "level": 1,
   "paras": [
    {
     "ref": "0.0",
     "text": "*Phrynocephalus forsythii*(Forsyth's toadhead agama, Forsyth's toad-headed lizard)는 아가마과(Agamidae)에 속하는 도마뱀의 한 종이다. 중국 고유종이다."
    }
   ]
  },
  {
   "h": "어원",
   "en": "Etymology",
   "level": 2,
   "paras": [
    {
     "ref": "1.0",
     "text": "종소명 *forsythii*는 영국 외교관 토머스 더글러스 포사이스(Thomas Douglas Forsyth)를 기리는 것이다."
    }
   ]
  },
  {
   "h": "분포",
   "en": "Geographic range",
   "level": 2,
   "paras": [
    {
     "ref": "2.0",
     "text": "*P. forsythii*는 중국 북서부 신장 위구르 자치구의 타림 분지(Tarim Basin) 지역에서 발견된다."
    }
   ]
  },
  {
   "h": "서식지",
   "en": "Habitat",
   "level": 2,
   "paras": [
    {
     "ref": "3.0",
     "text": "*P. forsythii*가 선호하는 자연 서식지는 사막이며 해발 887~3,200 m에 산다."
    }
   ]
  },
  {
   "h": "번식",
   "en": "Reproduction",
   "level": 2,
   "paras": [
    {
     "ref": "4.0",
     "text": "*P. forsythii*는 난태생이다. 한배 새끼 수는 1~6마리이다."
    }
   ]
  }
 ],
 "skipped": [],
 "notes": [
  {
   "ref": "0.0",
   "type": "번역 메모",
   "text": "이 종은 사이트에 국명이 없어 학명으로 적고 영어 일반명은 그대로 두었다."
  },
  {
   "ref": "3.0",
   "type": "번역 메모",
   "text": "피트 병기를 뺐다."

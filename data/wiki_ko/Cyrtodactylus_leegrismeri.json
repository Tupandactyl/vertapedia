   "en": "Habitat",
   "level": 2,
   "paras": [
    {
     "ref": "2.0",
     "text": "*C. leegrismeri*가 선호하는 자연 서식지는 해발 9~80m의 숲과 바위 지대이다."
    }
   ]
  },
  {
   "h": "형태",
   "en": "Description",
   "level": 2,
   "paras": [

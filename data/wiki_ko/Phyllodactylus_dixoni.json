   "paras": [
    {
     "ref": "1.0",
     "text": "종소명 dixoni는 미국의 파충류학자 제임스 R. 딕슨(James R. Dixon)을 기리는 것이다."
    }
   ]
  },
  {
   "h": "서식지",
   "en": "Habitat",
   "level": 2,
   "paras": [

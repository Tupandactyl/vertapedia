 "sections": [
  {
   "h": null,
   "en": null,
   "level": 1,
   "paras": [
    {
     "ref": "0.0",
     "text": "*Pachydactylus haackei*(Haacke's gecko, Haacke's thick-toed gecko)는 도마뱀부치과(Gekkonidae)에 속하는 도마뱀의 한 종이다. 아프리카 남부에 자생한다."
    }
   ]
  },
  {
   "h": "어원",
   "en": "Etymology",
   "level": 2,
   "paras": [
    {
     "ref": "1.0",
     "text": "종소명 *haackei*와 일반명은 트란스발 박물관의 파충류학자 울프 디트리히 하케(Wulf Dietrich Haacke, 1936년생)를 기리는 것이다."
    }
   ]
  },
  {
   "h": "분포",
   "en": "Geographic range",
   "level": 2,
   "paras": [
    {
     "ref": "2.0",
     "text": "*P. haackei*는 나미비아 남부와 남아프리카공화국에서 발견된다."
    }
   ]
  },
  {
   "h": "서식지",
   "en": "Habitat",
   "level": 2,
   "paras": [
    {
     "ref": "3.0",
     "text": "*P. haackei*가 선호하는 자연 서식지는 관목지의 바위 지대이며, 해발 100–1,600 m에서 산다."
    }
   ]
  },
  {
   "h": "형태",
   "en": "Description",
   "level": 2,
   "paras": [
    {
     "ref": "4.0",
     "text": "*P. haackei* 성체의 주둥이-총배설강 길이(SVL)는 보통 7–8 cm이며, 기록된 최대 SVL은 8.5 cm이다. 몸은 단단하고 귓구멍은 네모진 편이다."
    }
   ]
  },
  {
   "h": "행동",
   "en": "Behavior",
   "level": 2,
   "paras": [
    {
     "ref": "5.0",
     "text": "*P. haackei*는 땅과 바위에서 산다(rupicolous)."
    }
   ]
  },
  {
   "h": "번식",
   "en": "Reproduction",
   "level": 2,
   "paras": [
    {
     "ref": "6.0",
     "text": "*P. haackei*는 난생이다."
    }
   ]
  }
 ],

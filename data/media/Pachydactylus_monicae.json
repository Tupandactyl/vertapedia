 "wiki": {
  "title": "Monica's gecko",
  "url": "https://en.wikipedia.org/wiki/Monica%27s_gecko",
  "revision": 1354682421,
  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Monica's gecko (Pachydactylus monicae), also known commonly as Monica's thick-toed gecko, is a species of lizard in the family Gekkonidae. The species is native to southern Africa."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, monicae, is in honor of Monica Frelow Bauer who is the wife of Aaron M. Bauer."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "Pachydactylus monicae is found in mesic microhabitats near rivers and adjacent rocky outcrops in arid habitats. P. monicae is generally found below elevations of 100 meters (328 feet), but also can be found on the lower slopes of mountains up to 900 m (3,000 ft)."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "Pachydactylus monicae is found in the Lüdertiz and Karasburg districts of Namibia and the most northwestern part of the Northern Cape in South Africa."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "Relatively large for its genus, Pachydactylus monicae may attain a snout-to-vent length (SVL) of 4.8 cm (1.9 in)."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "Pachydactylus monicae is oviparous."
    ]
   }
  ]
 }
}
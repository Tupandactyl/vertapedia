 "wiki": {
  "title": "Acanthodactylus schmidti",
  "url": "https://en.wikipedia.org/wiki/Acanthodactylus_schmidti",
  "revision": 1355111819,
  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Acanthodactylus schmidti, also known commonly as Schmidt's fringe-fingered lizard or Schmidt's fringe-toed lizard, is a species of lizard in the family Lacertidae. The species is endemic to Western Asia."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, schmidti, is in honor of American herpetologist Karl Patterson Schmidt."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "Acanthodactylus schmidti is found in Iran, Iraq, Jordan, Kuwait, Oman, Qatar, Saudi Arabia, and United Arab Emirates."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of A. schmidti is desert, at altitudes up to 1,000 m (3,300 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "Acanthodactylus schmidti differs from all other species in the \"cantoris group\" by having the scales on the sides of the posterior dorsum larger than those in the middle of the dorsum. The largest recorded specimen is a male with a snout-to-vent length (SVL) of 10.3 cm (4.1 in)."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "Acanthodactylus schmidti is oviparous."
    ]
   }
  ],

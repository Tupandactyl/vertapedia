 "wiki": {
  "title": "Tropidophis boulengeri",
  "url": "https://en.wikipedia.org/wiki/Tropidophis_boulengeri",
  "revision": 1370468267,
  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Tropidophis boulengeri, commonly known as the northern eyelash boa, is a species of nonvenomous snake in the family Tropidophiidae. It was formerly treated as Trachyboa boulengeri. The species is endemic to Central America."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, boulengeri, is in honor of Belgian-born British herpetologist George Albert Boulenger."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "T. boulengeri is found in Colombia, western Ecuador, and Panama."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of T. boulengeri is evergreen lowland forest, at altitudes from sea level to 1,000 m (3,300 ft). It is usually found near freshwater flooded areas, irrigation ditches, and rivers."
    ]
   },
   {
    "h": "Diet",
    "level": 2,
    "paras": [
     "T. boulengeri preys on frogs and fishes."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "T. boulengeri is viviparous."
    ]
   }
  ]
 },

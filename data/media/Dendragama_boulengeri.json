 "wiki": {
  "title": "Boulenger's tree agama",
  "url": "https://en.wikipedia.org/wiki/Boulenger%27s_tree_agama",
  "revision": 1354921492,
  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Boulenger's tree agama  (Dendragama boulengeri) is a species of lizard in the family Agamidae. The species is endemic to Sumatra."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "Both the specific name, boulengeri, and the common name, Boulenger's tree agama, are in honor of Belgian-born British herpetologist George Albert Boulenger."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of D. boulengeri is forest, at altitudes of 1,000–1,533 m (3,281–5,030 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "Dorsally, D. boulengeri is bluish green, with blackish crossbars. Ventrally it is pinkish, with brown spots. It may attain a snout-to-vent length (SVL) of 7.3 cm (2.9 in), with a tail length of 16 cm (6.3 in)."
    ]
   },
   {
    "h": "Behavior",
    "level": 2,
    "paras": [
     "D. boulengeri is arboreal and diurnal."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "D. boulengeri is oviparous. Clutch size is two to four eggs, and the female lays more than one clutch per year."
    ]
   }
  ],

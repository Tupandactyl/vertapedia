 "wiki": {
  "title": "Lawrence's girdled lizard",
  "url": "https://en.wikipedia.org/wiki/Lawrence%27s_girdled_lizard",
  "revision": 1354649749,
  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Lawrence's girdled lizard (Namazonurus lawrenci) is a species of lizard in the family Cordylidae. The species is endemic to South Africa."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, lawrenci, is in honor of South African entomologist Reginald Frederick Lawrence."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "N. lawrencei is small, thin, and flat for its genus. Dorsally, it is dark brown. Ventrally, it is brownish gray to whitish. Adults usually have a snout-to-vent length (SVL) of 6.5–7.0 cm (2.6–2.8 in)."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "N. lawrenci is found in the Richtersveld in the province of Northern Cape, South Africa."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitats of N. lawrenci are rocky areas and shrubland, at altitudes of 250–1,375 m (820–4,511 ft)."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "N. lawrenci is ovoviviparous."
    ]
   }
  ]
 },

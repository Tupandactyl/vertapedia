  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Liolaemus hermannunezi is a species of lizard in the family  Liolaemidae. The species is native to Chile and perhaps Argentina."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, hermannunezi, is in honor of Chilean herpetologist Herman Núñez."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "L. hermannunezi is known only from its type locality in Biobío Region, central Chile, but it may also occur in adjacent Argentina."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitats of L. hermannunezi are grassland and shrubland, at altitudes of 1,428–1,521 m (4,685–4,990 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "Small for its genus, L. hermannunezi, has an average snout-to-vent length (SVL) of 5.3 cm (2.1 in). The belly is black."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "L. hermannunezi is oviparous."
    ]
   }
  ]
 }

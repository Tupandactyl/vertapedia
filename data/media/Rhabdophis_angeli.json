   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "Rhabdophis angeli is found in northern Vietnam, in Thái Nguyên Province and Vĩnh Phúc Province."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [

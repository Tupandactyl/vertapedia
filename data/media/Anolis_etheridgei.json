  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Anolis etheridgei, also known commonly as Etheridge's anole and the montane bush anole, is a species of lizard in the family Dactyloidae. The species is endemic to",
     "the Dominican Republic."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, etheridgei, is in honor of American herpetologist Richard Emmett Etheridge."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "A. etheridgei occurs in the Cordillera Central, Dominican Republic."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of A. etheridgei is forest, at altitudes of 550–2,440 m (1,800–8,010 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "A small anole, A. etheridgei may attain a snout-to-vent length of 4.3 cm (1.7 in). The tail is long, more than twice SVL. The dewlap is small and white, and the iris of the eye is blue."
    ]
   },
   {
    "h": "Diet",
    "level": 2,
    "paras": [
     "A. etheridgei preys upon invertebrates."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "A. etheridgei is oviparous."
    ]
   }
  ]
 }

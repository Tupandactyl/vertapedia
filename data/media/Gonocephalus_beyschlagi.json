  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Gonocephalus beyschlagi, also known commonly as the Sumatra forest dragon, is a species of lizard in the family Agamidae. The species is native to northern Sumatra, Indonesia."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, beyschlagi, is in honor of Fritz Beyschlag who collected the holotype."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of G. beyschlagi is forest, at altitudes below 500 m (1,600 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "G. beyschlagi may attain a snout-to-vent length (SVL) of 11.5 cm (4.5 in), with a tail length of 28 cm (11 in)."
    ]
   },
   {
    "h": "Behavior",
    "level": 2,
    "paras": [
     "G. beyschlagi is arboreal and diurnal."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "G. beyschlagi is oviparous."
    ]
   }
  ]
 },

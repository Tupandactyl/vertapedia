   {
    "h": null,
    "level": 1,
    "paras": [
     "Liolaemus paulinae is a species of lizard in the family Liolaemidae. The species is endemic to Chile."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "Both the specific name, paulinae, and the common name, Paulina's tree iguana, are in honor of Paulina who is one of the daughters of Roberto Donoso-Barros."
    ]
   },
   {
    "h": "Geographic distribution",
    "level": 2,
    "paras": [
     "Liolaemus paulinae occurs in Antofagasta Region, Chile."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of Liolaemus paulinae is shrubland, at elevations of 2,200–2,600 m (7,200–8,500 ft). The holotype was collected at an elevation of 2,600 metres (8,500 ft)."
    ]
   },
   {
    "h": "Diet",
    "level": 2,
    "paras": [
     "Liolaemus paulinae preys upon arthropods."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "Liolaemus paulinae is ovoviviparous."
    ]
   }
  ]
 }

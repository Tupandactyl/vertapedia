 "wiki": {
  "title": "Vietnamese leopard gecko",
  "url": "https://en.wikipedia.org/wiki/Vietnamese_leopard_gecko",
  "revision": 1343337441,
  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "The Vietnamese leopard gecko or Chinese tiger gecko (Goniurosaurus araneus) is a species of lizards in the family Eublepharidae. It is found in the Cao Bằng Province of Vietnam and Guangxi in China. The scientific species name, is from the Latin, aranea, which means \"spider\", due to the spindly, spider-like form of this species."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "The Vietnamese tiger gecko is dark gray in color and has many black spots and four wide orange bands across the back. Its eyes are dark reddish brown. Goniurosaurus araneus is distinguished from other species of the same genus by its elongated dorsal scales. This gecko has a maximum length (including tail) of 190 mm (7.5 in)."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The habitat of the Vietnamese tiger gecko is primarily rocky. It is found in humid and shady areas and in mountainous terrain or near caves."
    ]
   }
  ]
 }

   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "G. shibatai is found in the Tokara Group of the Ryukyu Islands. The type locality is Takarajima Island."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of G. shibatai, is forest."
    ]
   },

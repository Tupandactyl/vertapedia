   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "E. albipuncta is found in Argentina, Bolivia, southwestern Brazil, Paraguay, Uruguay, and possibly southern Peru."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitats of E. albipuncta are grassland, shrubland, savanna, and forest."
    ]
   },
   {

 "wiki": {
  "title": "Saltuarius moritzi",
  "url": "https://en.wikipedia.org/wiki/Saltuarius_moritzi",
  "revision": 1355109809,
  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Saltuarius moritzi, also known commonly as the New England leaf-tailed gecko or Moritz's leaf-tailed gecko, is a species of lizard in the family Carphodactylidae. The species is native to Australia."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, moritzi, is in honor of Australian herpetologist Craig Moritz."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "Adults of Saltuarius moritzi usually have a snout-to-vent length (SVL) of about 11 cm (4.3 in). The rostral contacts the nostrils. There are large spinose tubercles on the upper surface of the digits. The coloration is extremely variable."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "Saltuarius moritzi is endemic to the New England Tablelands in New South Wales."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitats of S. moritzi are closed forests, wet sclerophyll forests, and rocky escarpments, gorges, and outcrops."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "Saltuarius moritzi may attain a snout-to-vent length (SVL) of 10.9 cm (4.3 in)."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "Saltuarius moritzi is oviparous."
    ]
   }
  ]
 }

  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "The false tomodon snake (Tachymenis trigonatus) is a species of venomous snake in the subfamily Dipsadinae of the family Colubridae. The species is endemic to Argentina."
    ]
   },
   {
    "h": "Taxonomy",
    "level": 2,
    "paras": [
     "Tachymenis trigonatus is part of the 36 species of the tribe Tachymenini."
    ]
   },
   {
    "h": "Geographic distribution",
    "level": 2,
    "paras": [
     "Tachymenis trigonatus is found in the western and southern regions of the Monte Desert in western Argentina."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of Tachymenis trigonatus is shrubland."
    ]
   },
   {
    "h": "Characteristics",
    "level": 2,
    "paras": [
     "The false tomodon snake is characterized by its coloration and number of scales. As part of the genus Tachymenis, it has morphological characters of maxillary teeth with grooved fangs, and a vertical pupil. The false tomodon snake has eight or fewer maxillary teeth. The body is marked dorsally by a distinguishing yellowish vertebral line. The dorsal scales are arranged in 19 rows at midbody. Adults have a total length (tail included) of about 45 cm (18 in)."
    ]
   },
   {
    "h": "Behavior",
    "level": 2,
    "paras": [
     "Tachymenis trigonatus is terrestrial."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "Tachymenis trigonatus is ovoviviparous."
    ]
   }
  ]
 },

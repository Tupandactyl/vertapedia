  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "The masked bunting (Schoeniclus personatus) is a passerine bird in the bunting family Emberizidae. It is found in Sakhalin, the Kuril Islands, and Japan.",
     "The masked bunting was formerly considered as a subspecies of the black-faced bunting (Schoeniclus spodocephalus) but is now treated as a separate species based on morphological and genetic differences. The species is monotypic: no subspecies are recognised.",
     "This species was formerly placed in the genus Emberiza but in 2026 it was moved to the resurrected genus Schoeniclus. This was based on the results of a 2021 molecular genetic study that included the black-faced bunting but not the masked bunting."
    ]
   }

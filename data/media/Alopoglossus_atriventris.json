 "wiki": {
  "title": "Alopoglossus atriventris",
  "url": "https://en.wikipedia.org/wiki/Alopoglossus_atriventris",
  "revision": 1360212640,
  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Alopoglossus atriventris, known commonly as the keel-bellied shade lizard, is a species of lizard in the family Alopoglossidae. The species is endemic to northwestern South America."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, atriventris, is from Latin ater (black) + venter (belly), referring to the black belly of the male."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "A. atriventris is found in Brazil (Acre, western Amazonas), Colombia, Ecuador, and Peru."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The natural habitat of A. atriventris is lowland tropical forest at altitudes of 130–1,500 m (430–4,920 ft), where it lives in the leaf litter of the forest floor."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "A. atriventris is oviparous."
    ]
   }
  ]
 },

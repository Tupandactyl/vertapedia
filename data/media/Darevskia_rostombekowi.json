    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, rostombekowi, is in honor of Georgian biologist V. N. Rostombekov."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "D. rostombekowi is found in Armenia and Azerbaijan."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred habitats of D. rostombekowi are rocky areas and shrubland, at altitudes of 600–1,700 m (2,000–5,600 ft)."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,

    "paras": [
     "Grismer's bent-toed gecko (Cyrtodactylus grismeri)  is a species of lizard in the family Gekkonidae. The species is endemic  to southwestern Vietnam."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, grismeri, is in honor of American herpetologist Larry Lee Grismer."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of C. grismeri is caves in forest, at altitudes around 100 m (330 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "C. grismeri is reddish brown, and has an average snout-to-vent length (SVL) of 88 mm (3.5 in)."
    ]
   },
   {
    "h": "Behavior",
    "level": 2,
    "paras": [
     "C. grismeri is terrestrial, nocturnal, and saxicolous."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "C. grismeri is oviparous."
    ]
   }
  ]

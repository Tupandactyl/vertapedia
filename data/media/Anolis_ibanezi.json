  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Anolis ibanezi is a species of lizard in the family Dactyloidae. The species is native to Central America."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, ibanezi, is in honor of Panamanian herpetologist Roberto Ibáñez."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "A. ibanezi found in Costa Rica and Panama."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of A. ibanezi is forest, at altitudes of 400–1,070 m (1,310–3,510 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "Large and long-legged for its genus, A. ibanezi may attain a snout-to-vent length (SVL) of 8 cm (3.1 in). Dorsally, it is bright green, and the area around the eye is bright yellow."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "A. ibanezi is oviparous."
    ]
   }
  ]
 },

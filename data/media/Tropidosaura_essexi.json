 "wiki": {
  "title": "Tropidosaura essexi",
  "url": "https://en.wikipedia.org/wiki/Tropidosaura_essexi",
  "revision": 1354683312,
  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Tropidosaura essexi, also known commonly as Essex's mountain lizard, is a species of lizard in the family Lacertidae. The species is native to southern Africa."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, essexi, is in honor of South African herpetologist Robert Essex."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "T. essexi is found in Lesotho and South Africa."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of T. essexi is grassland, at altitudes of 2,400–3,400 m (7,900–11,200 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "T. essexi is small for its genus. Adults have a snout-to-vent length (SVL) of only 4–5 cm (1.6–2.0 in)."
    ]
   },
   {
    "h": "Behavior",
    "level": 2,
    "paras": [
     "T. essexi is diurnal and terrestrial."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "T. essexi is viviparous, and is the only African lacertid known to be viviparous."
    ]
   }
  ]
 },

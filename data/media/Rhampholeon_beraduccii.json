  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Rhampholeon beraduccii, also known commonly as Beraducci's pygmy chameleon or the Mahenge pygmy chameleon, is a species of lizard in the family Chamaeleonidae. The species is endemic to Tanzania."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, beraduccii, is in honor of Italian herpetologist Joe Beraducci."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "R. beraducii is found in the Mahenge Mountains of Tanzania."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of R. beraduccii is forest, at altitudes of 1,200–1,500 m (3,900–4,900 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "R. beraduccii is brown and very small. The maximum recorded snout-to-vent length (SVL) is only 28 mm (1.1 in). The tail is very short, about one fourth SVL."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "R. beraduccii is oviparous."
    ]
   }
  ]
 },

    "level": 2,
    "paras": [
     "P. gabriellae is found in southern Madagascar in the vicinity of the cities Tôlanaro and Toliara."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred habitat of P. gabriellae is forest at altitudes of 120–240 m (390–790 ft)."

   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, wolteri, is in honor of German amateur naturalist Karl Andreas Wolter, who collected the holotype."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "T. wolteri is found in eastern China, Korea, and eastern Russia."
    ]
   },

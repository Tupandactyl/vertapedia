 "wiki": {
  "title": "Lang's crag lizard",
  "url": "https://en.wikipedia.org/wiki/Lang%27s_crag_lizard",
  "revision": 1354936320,
  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Lang's crag lizard (Pseudocordylus langi), also known commonly as Lang's girdled lizard, is a species of lizard in the family Cordylidae. The species is endemic to Southern Africa."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, langi, is in honor of German taxidermist Herbert Lang."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "P. langi is found in Lesotho and South Africa where it is restricted to the summit of the Drakensberg at altitudes of 2,700–3,100 m (8,900–10,200 ft)."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of P. langi is grassland."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "P. langi is ovoviviparous."
    ]
   }
  ]
 },

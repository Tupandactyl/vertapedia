 "wiki": {
  "title": "Agama doriae",
  "url": "https://en.wikipedia.org/wiki/Agama_doriae",
  "revision": 1355146491,
  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Agama doriae, also known commonly as the Benoue agama, Doria's agama, and the Nigeria agama, is a species of lizard in the family Agamidae. The species is endemic to Africa. There are two recognized subspecies."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, doriae, is in honor of Italian naturalist Giacomo Doria."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "A. doriae is found in Cameroon, Central African Republic, Eritrea, Ethiopia, Ghana, Nigeria, Sudan, and Togo."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of A. doriae is rocky areas in forest, savanna, and shrubland, at altitudes of 700–2,300 m (2,300–7,500 ft), but it is also found in agricultural areas."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "Adults of A. doriae have a snout-to-vent-length (SVL) of about 10.5 cm (4.1 in)."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "A. doriae is oviparous."
    ]
   },
   {
    "h": "Subspecies",
    "level": 2,
    "paras": [
     "Two subspecies are recognized as being valid, including the nominotypical subspecies.",
     "Agama doriae benueensis Monard, 1951",
     "Agama doriae doriae Boulenger, 1885"
    ]
   }
  ]
 }

  "revision": 1355110888,
  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Phelsuma hielscheri is a species of gecko, a lizard in the family Gekkonidae. The species is endemic to Madagascar."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, hielscheri, is in honor of German biochemist Michael Hielscher who was one of the discoverers of this species."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "Phelsuma hielscheri is found in central and western Madagascar, at elevations from sea level to 900 m (3,000 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "Males of P. hielscheri are larger than females. The maximum recorded total length (including tail) for a male is 17 cm (6.7 in), whereas for a female it is only 15 centimetres (5.9 in)."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "Phelsuma hielscheri is found on screw palms (Pandanus) in both wild and urban settings."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "Phelsuma hielscheri is oviparous."
    ]
   }
  ]
 }

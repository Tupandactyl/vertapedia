  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Acanthocercus adramitanus, also known commonly as Anderson's rock agama or the Hadramaut agama, is a small species of lizard in the family Agamidae. The species is endemic to the Arabian Peninsula."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "A. adramitanus is found in Oman, Saudi Arabia, and Yemen."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of A. adramitanus is rocky areas, at altitudes of 2,000 m (6,600 ft) or less."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "A. adramitanus may attain a snout-to-vent length (SVL) of 15 cm (5.9 in).  The tail is long, about twice SVL. Females are slightly smaller than males. Females may be bluish, and males may be intensely blue."
    ]
   },
   {
    "h": "Diet",
    "level": 2,
    "paras": [
     "A. adramitanus preys upon insects."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "A. adramitanus is oviparous."
    ]
   }
  ]
 },

  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Emoia slevini, also known commonly as the Mariana skink, Slevin's brown skink, Slevin's emo skink, and Slevin's skink, is a species of lizard in the family Scincidae. The species is endemic to the Mariana Islands."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, slevini, is in honor of American herpetologist Joseph Richard Slevin."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of E. slevini is forest, at altitudes from sea level to 400 m (1,300 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "E. slevini is a moderately large-sized species for its genus. Adults have a snout-to-vent length of 5.8–8.5 cm (2.3–3.3 in)."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "E. slevini is oviparous."
    ]
   }
  ]
 },

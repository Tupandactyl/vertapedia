  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Calumma boettgeri is a species of chameleon, a lizard in the family Chamaeleonidae. The species is endemic to Madagascar."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, boettgeri, is in honor of German herpetologist Oskar Boettger."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "C. boettgeri is found in northern Madagascar, including the island of Nosy Be."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of C. boettgeri is forest, at altitudes of 810–1,200 m (2,660–3,940 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "C. boettgeri may attain a snout-to-vent length (SVL) of 5.5 cm (2.2 in), and tail length equals SVL."
    ]
   },
   {
    "h": "Behavior",
    "level": 2,
    "paras": [
     "C. boettgeri is arboreal, and is usually found 1–2 m (3.3–6.6 ft) above the forest floor."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "C. boettgeri is oviparous."
    ]
   }
  ]
 }

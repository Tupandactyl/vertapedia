    "level": 2,
    "paras": [
     "Eremias nikolskii is found in Kazakhstan, Kyrgyzstan, Tajikistan, and Uzbekistan."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of Eremias nikolskii is rocky shrubland, at elevations of 1,000–3,000 m (3,300–9,800 ft)."
    ]

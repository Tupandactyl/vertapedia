    "h": null,
    "level": 1,
    "paras": [
     "Helicops pastazae, also known commonly as Shreve's keelback and la culebra de agua de Pastaza in South American Spanish, is a species of snake in the subfamily Dipsadinae of the family Colubridae. The species is native to northwestern South America."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, pastazae, refers to the Pastaza River."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "Helicops pastazae may attain a total length (tail included) of 67 cm (26 in)."
    ]
   },
   {
    "h": "Geographic distribution",
    "level": 2,
    "paras": [
     "Helicops pastazae is found in Bolivia, Colombia, Ecuador, Peru, and Venezuela."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of Helicops pastazae is freshwater wetlands in forest, at elevations of 200–900 m (660–2,950 ft)."
    ]
   },
   {
    "h": "Behavior",
    "level": 2,
    "paras": [
     "Helicops pastazae is semiaquatic."
    ]
   },
   {
    "h": "Diet",
    "level": 2,
    "paras": [
     "Helicops pastazae preys upon freshwater fishes."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "Helicops pastazae is ovoviviparous."
    ]
   }

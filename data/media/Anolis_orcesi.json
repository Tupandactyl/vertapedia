  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Anolis orcesi, also known commonly as Orces' Andes anole or Orces's Andes anole, is a species of lizard in the family Dactyloidae. The species is native to Ecuador."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, orcesi, is in honor of Ecuadorian herpetologist Gustavo Orcés."
    ]
   },
   {
    "h": "Geographic distribution",
    "level": 2,
    "paras": [
     "Anolis orcesi is found in Napo Province, Ecuador, on the eastern slopes of the Andes."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of Anolis orcesi is forest, at elevations of 1,510–1,768 m (4,954–5,801 ft)."
    ]
   },
   {
    "h": "Behavior",
    "level": 2,
    "paras": [
     "Anolis orcesi is arboreal, perching on branches above 2 m (6.6 ft) but below the forest canopy."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "Anolis orcesi is oviparous."
    ]
   }
  ]
 },

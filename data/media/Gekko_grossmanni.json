   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "G. grossmanni is found in Khánh Hòa Province, southern Vietnam."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of G. grossmanni is forest, at altitudes from sea level to 200 m (660 ft)."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [

    "h": null,
    "level": 1,
    "paras": [
     "Dunn's least gecko (Sphaerodactylus dunni) is a species of lizard in the family Sphaerodactylidae. The species is endemic to Honduras."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, dunni, is in honor of American herpetologist Emmett Reid Dunn."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "S. dunni is found in northern Honduras."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of S. dunni is forest, at altitudes of 60–700 m (200–2,300 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "The holotype of S. dunni has a snout-to-vent length (SVL) of 25 mm (0.98 in). The dorsal scales are keeled and imbricate (overlapping)."
    ]
   },
   {
    "h": "Behavior",
    "level": 2,
    "paras": [
     "S. dunni is terrestrial and diurnal."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "S. dunni is oviparous."
    ]
   }
  ]
 }

 "wiki": {
  "title": "Alopoglossus buckleyi",
  "url": "https://en.wikipedia.org/wiki/Alopoglossus_buckleyi",
  "revision": 1360211287,
  "sections": [
   {
    "h": null,
    "level": 1,
    "paras": [
     "Alopoglossus buckleyi, also known commonly as Buckley's shade lizard and Buckley's teiid, is a species of lizard in the family Alopoglossidae. The species is native to northwestern South America."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, buckleyi, is in honor of Clarence Buckley (1839–1889) who collected the holotype."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "A. buckleyi is found in Brazil (Amazonas, Acre), Colombia (Amazonas), eastern Ecuador, and eastern Peru (Loreto)."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The natural habitat of A. buckleyi is forest at altitudes of 230–1,830 m (750–6,000 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "A. buckleyi is a small species of lizard. The holotype has a snout-to-vent length (SVL) of 5.1 cm (2.0 in)."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "A. buckleyi is oviparous."
    ]
   }
  ]
 },

   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, cib, refers to the Chengdu Institute of Biology (CIB), where the holotype was collected from a wall surface."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "G. cib is found in Southwestern China, in the provinces of Sichuan and Yunnan."
    ]

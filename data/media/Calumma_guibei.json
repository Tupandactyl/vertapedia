   {
    "h": null,
    "level": 1,
    "paras": [
     "Calumma guibei, also known commonly as Guibé's chameleon, is a species of chameleon, a lizard in the family Chamaeleonidae. The species is endemic to Madagascar."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, guibei, is in honor of French herpetologist Jean Guibé."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "C. guibei is found in northern Madagascar. The type locality is Mt. Tsaratanana, elevation 1,800 m (5,900 ft)."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of C. guibei is forest, at elevations of 1,000–2,250 m (3,280–7,380 ft)."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "C. guibei has an average snout-to-vent length (SVL) of about 5 cm (2.0 in). It has a soft dermal rostral appendage, which is longer in males than in females."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "C. guibei is oviparous."
    ]
   }
  ]
 },

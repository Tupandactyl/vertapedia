    "h": null,
    "level": 1,
    "paras": [
     "Pachydactylus scherzi is a lizard species in the Gekkonidae family. The species is native to Southern Africa."
    ]
   },
   {
    "h": "Etymology",
    "level": 2,
    "paras": [
     "The specific name, scherzi, is in honor of German chemical engineer Ernst Rudolph Scherz (1906–1981)."
    ]
   },
   {
    "h": "Geographic range",
    "level": 2,
    "paras": [
     "P. scherzi is found in Angola and Namibia."
    ]
   },
   {
    "h": "Habitat",
    "level": 2,
    "paras": [
     "The preferred natural habitat of P. scherzi is rocky outcrops in the desert or the savanna."
    ]
   },
   {
    "h": "Description",
    "level": 2,
    "paras": [
     "Adults of P. scherzi have a snout-to-vent length (SVL) of 2.5–3.5 centimetres (0.98–1.38 in). Dorsally, P. scherzi is brown, with whitish crossbands that are edged with dark brown and often broken in the middle. Ventrally, it is cream-colored."
    ]
   },
   {
    "h": "Reproduction",
    "level": 2,
    "paras": [
     "P. scherzi is oviparous."
    ]
   }
  ]
 }
